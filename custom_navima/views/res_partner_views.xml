<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Partner customization & migration fields : -->
    <record id="res_partner_navima_inh_form" model="ir.ui.view">
        <field name="name">res.partner.navima.inh.form</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="migration_page">
                    <group name="migration_fields">


                        <field name="mig_subcuenta"/>
                        <field name="mig_agente"/>
                        <field name="mig_inconterm"/>
                        <field name="mig_fpago"/>
                        <field name="mig_aseguradora"/>
                        <field name="mig_concedido"/>
                        <field name="mig_posicionfiscal"/>
                        <field name="mig_responsableinterno"/>
                        <field name="mig_provincia"/>
                        <field name="mig_vat"/>
                    </group>
                </page>
            </xpath>
        </field>
        <field name="priority">99</field>
    </record>

</odoo>
